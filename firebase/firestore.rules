rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function minutes(time) {
      let parts = time.split(':');
      return int(parts[0]) * 60 + int(parts[1]);
    }
    function validGuest(guests, id) {
      return !(id in guests) || (guests[id] is map
        && guests[id].keys().hasAll(['name']) && guests[id].keys().hasOnly(['name'])
        && guests[id].name is string && guests[id].name.size() >= 1 && guests[id].name.size() <= 12
        && guests[id].name.matches('^[^ ].*[^ ]$|^[^ ]$'));
    }
    function validGuests(guests) {
      return guests is map
        && guests.keys().hasOnly(['guest001', 'guest002', 'guest003', 'guest004', 'guest005', 'guest006', 'guest007', 'guest008'])
        && validGuest(guests, 'guest001') && validGuest(guests, 'guest002')
        && validGuest(guests, 'guest003') && validGuest(guests, 'guest004')
        && validGuest(guests, 'guest005') && validGuest(guests, 'guest006')
        && validGuest(guests, 'guest007') && validGuest(guests, 'guest008');
    }
    function validHeader(date) {
      let d = request.resource.data;
      let window = (minutes(d.endTime) - minutes(d.startTime)) / 30;
      let guests = d.get('guests', {});
      let generation = d.get('generation', 'legacy');
      return d.keys().hasAll(['schemaVersion', 'date', 'participantIds', 'fixedPlayerIds', 'startTime', 'endTime', 'roundMinutes', 'partnerRepeats', 'lockedPairs', 'roundCount', 'matchCount', 'createdAt', 'generation'])
        && d.keys().hasOnly(['schemaVersion', 'date', 'participantIds', 'fixedPlayerIds', 'guests', 'startTime', 'endTime', 'roundMinutes', 'partnerRepeats', 'lockedPairs', 'roundCount', 'matchCount', 'createdAt', 'generation'])
        && generation.matches('^[a-f0-9]{32}$')
        && !exists(/databases/$(database)/documents/clubs/gdr/sessionCancellations/$(date + '--' + generation))
        && d.schemaVersion == 2 && d.date == date
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.participantIds is list && d.participantIds.size() >= 4 && d.participantIds.size() <= 22
        && d.participantIds.toSet().size() == d.participantIds.size()
        && d.fixedPlayerIds is list && d.fixedPlayerIds.toSet().size() == d.fixedPlayerIds.size()
        && d.fixedPlayerIds.hasOnly(['gdr001', 'gdr002', 'gdr003', 'gdr004', 'gdr005', 'gdr006', 'gdr007', 'gdr008', 'gdr009', 'gdr010', 'gdr011', 'gdr012', 'gdr013', 'gdr014'])
        && validGuests(guests) && guests.keys().hasOnly(d.participantIds)
        && d.participantIds.hasOnly(d.fixedPlayerIds.concat(guests.keys()))
        && d.participantIds.size() == d.fixedPlayerIds.size() + guests.size()
        && d.startTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && d.endTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && window >= 1 && window <= 47 && d.roundMinutes == 30
        && d.roundCount is int && d.roundCount >= 1 && d.roundCount <= window
        && d.matchCount is int && d.matchCount >= d.roundCount && d.matchCount <= d.roundCount * 2
        && d.lockedPairs is list && d.lockedPairs.size() <= 7
        && d.partnerRepeats is int && d.partnerRepeats >= 0
        && d.createdAt == request.time;
    }
    function validRound(date, roundId) {
      let d = request.resource.data;
      let s = getAfter(/databases/$(database)/documents/clubs/gdr/sessions/$(date)).data;
      let first = 'r' + roundId + '-c1';
      let second = 'r' + roundId + '-c2';
      let a = d.matchMap.get(first, {'teamA': [], 'teamB': []});
      let b = d.matchMap.get(second, {'teamA': [], 'teamB': []});
      let ids = a.teamA.concat(a.teamB).concat(b.teamA).concat(b.teamB);
      return s.schemaVersion == 2
        && d.keys().hasAll(['round', 'matchMap']) && d.keys().hasOnly(['round', 'matchMap'])
        && d.round is int && d.round >= 1 && d.round <= s.roundCount && roundId == string(d.round)
        && d.matchMap is map && d.matchMap.size() >= 1 && d.matchMap.size() <= 2
        && d.matchMap.keys().hasOnly([first, second])
        && (!(first in d.matchMap) || (a.keys().hasOnly(['round', 'court', 'teamA', 'teamB']) && a.round == d.round && a.court == 1 && a.teamA.size() == 2 && a.teamB.size() == 2))
        && (!(second in d.matchMap) || (b.keys().hasOnly(['round', 'court', 'teamA', 'teamB']) && b.round == d.round && b.court == 2 && b.teamA.size() == 2 && b.teamB.size() == 2))
        && ids.toSet().size() == ids.size() && ids.hasOnly(s.participantIds);
    }
    match /clubs/gdr/sessions/{date} {
      allow read: if true;
      allow create: if validHeader(date);
      allow update: if false;
      allow delete: if cancelling(date);
      match /rounds/{roundId} {
        allow read: if true;
        allow create: if validRound(date, roundId);
        allow update: if false;
        allow delete: if cancelling(date);
      }
    }
    function cancelling(date) {
      let header = get(/databases/$(database)/documents/clubs/gdr/sessions/$(date)).data;
      let generation = header.get('generation', 'legacy');
      let receipt = /databases/$(database)/documents/clubs/gdr/sessionCancellations/$(date + '--' + generation);
      return !existsAfter(/databases/$(database)/documents/clubs/gdr/sessions/$(date))
        && !exists(receipt) && existsAfter(receipt)
        && getAfter(receipt).data.confirmation == date + ' 대진 취소'
        && getAfter(receipt).data.cancelledAt == request.time;
    }
    match /clubs/gdr/sessionCancellations/{cancellationId} {
      function validCancellation() {
        let d = request.resource.data;
        let header = get(/databases/$(database)/documents/clubs/gdr/sessions/$(d.date)).data;
        return d.keys().hasAll(['date', 'generation', 'confirmation', 'cancelledAt'])
          && d.keys().hasOnly(['date', 'generation', 'confirmation', 'cancelledAt'])
          && cancellationId == d.date + '--' + d.generation
          && d.generation == header.get('generation', 'legacy')
          && d.confirmation == d.date + ' 대진 취소'
          && d.cancelledAt == request.time
          && !existsAfter(/databases/$(database)/documents/clubs/gdr/sessions/$(d.date));
      }
      allow read: if true;
      allow create: if validCancellation();
      allow update, delete: if false;
    }
    function savedMatches(date, matchId) {
      let s = get(/databases/$(database)/documents/clubs/gdr/sessions/$(date)).data;
      let roundId = matchId.split('-')[0].replace('^r', '');
      return s.schemaVersion == 2
        ? get(/databases/$(database)/documents/clubs/gdr/sessions/$(date)/rounds/$(roundId)).data.matchMap
        : s.matchMap;
    }
    match /clubs/gdr/matchResults/{resultId} {
      function validResult() {
        let d = request.resource.data;
        let s = get(/databases/$(database)/documents/clubs/gdr/sessions/$(d.date)).data;
        return d.keys().hasAll(['date', 'matchId', 'scoreA', 'scoreB', 'outcome', 'revision', 'updatedAt'])
          && d.keys().hasOnly(['date', 'matchId', 'scoreA', 'scoreB', 'outcome', 'revision', 'updatedAt', 'generation'])
          && d.get('generation', 'legacy') == s.get('generation', 'legacy')
          && existsAfter(/databases/$(database)/documents/clubs/gdr/sessions/$(d.date))
          && resultId == d.date + '_' + d.matchId && d.matchId in savedMatches(d.date, d.matchId)
          && d.scoreA is int && d.scoreA >= 0 && d.scoreA <= 99
          && d.scoreB is int && d.scoreB >= 0 && d.scoreB <= 99
          && d.outcome == (d.scoreA > d.scoreB ? 'teamA' : (d.scoreA < d.scoreB ? 'teamB' : 'draw'))
          && d.revision is int && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if validResult() && request.resource.data.revision == 1;
      allow update: if validResult()
        && request.resource.data.date == resource.data.date && request.resource.data.matchId == resource.data.matchId
        && request.resource.data.get('generation', 'legacy') == resource.data.get('generation', 'legacy')
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if cancelling(resource.data.date);
    }
    // Historical snapshots are imported by the project administrator only.
    // Members may view them; client writes cannot alter the source archive.
    match /clubs/gdr/historySets/{setId} {
      allow read: if true;
      allow write: if false;
    }
    match /clubs/gdr/historySources/{sourceId} {
      allow read: if true;
      allow write: if false;
    }
    match /clubs/gdr/historyImports/{importId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
